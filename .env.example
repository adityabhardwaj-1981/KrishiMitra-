# =============================================================================
# KrishiMitra AI - Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# ---- Server ----
# Port on which the backend API server runs
PORT=5000
# Base URL of the backend API
API_URL=http://localhost:5000/api

# ---- Database ----
# Path to the SQLite database file (relative to server directory)
# Set to ':memory:' for an in-memory database (recommended for tests only)
DB_PATH=./db/krishimitra.sqlite

# ---- Authentication ----
# Secret used to sign JWT tokens. Use a long random string in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
# Token expiry in days
JWT_EXPIRES_IN=7d

# ---- Frontend (CORS origin) ----
# The origin from which the React app is served
CLIENT_ORIGIN=http://localhost:5173

# ---- AI Service ----
# AI mode: 'mock' uses the built-in fallback engine (works offline).
# Leave AI_PROVIDER empty to use the mock engine.
# To use an external provider, set AI_PROVIDER and its keys.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=

# OpenWeatherMap API key for real weather (optional). If empty, simulation is used.
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ---- Admin user (seed) ----
ADMIN_EMAIL=admin@krishimitra.ai
ADMIN_PASSWORD=Admin@123

